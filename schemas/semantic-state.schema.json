{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smtyx.io/schema/semantic-state-0.2.json",
  "title": "SMTYX Semantic State v0.2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "protocol", "protocol_version", "state_id", "trace_id", "source",
    "intent", "object", "status", "confidence", "payload", "evidence",
    "permissions", "ack"
  ],
  "properties": {
    "protocol": {"const": "SMTYX"},
    "protocol_version": {"const": "0.2"},
    "state_id": {"type": "string", "minLength": 1},
    "parent_state_id": {"type": ["string", "null"]},
    "trace_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string"},
        "id": {"type": "string"}
      },
      "additionalProperties": true
    },
    "destination": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {
            "kind": {"type": "string"},
            "id": {"type": "string"}
          },
          "additionalProperties": true
        }
      ]
    },
    "intent": {"type": "string", "minLength": 1},
    "object": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["PROPOSED", "PARSED", "AMBIGUOUS", "VERIFIED", "FINAL", "CONFLICT", "DENIED", "FAILED", "STALE"]
    },
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "payload": {"type": "object"},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "permissions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "ack": {
      "type": "array",
      "items": {"enum": ["ACK_RECEIVED", "ACK_PARSED", "ACK_SEMANTIC", "ACK_VERIFIED", "ACK_FINAL"]}
    },
    "metadata": {"type": "object"}
  }
}
