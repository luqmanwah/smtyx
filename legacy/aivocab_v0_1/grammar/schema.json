{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vocab_Agent Canonical State v0.1",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^0\\.1$",
      "description": "Schema version"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Ordered action tokens"
    },
    "object": {
      "type": "string",
      "description": "Primary object token"
    },
    "target": {
      "type": ["string", "null"],
      "description": "Target token from STATE-like categories"
    },
    "state": {
      "type": ["string", "null"],
      "description": "Execution/state marker"
    },
    "priority": {
      "type": ["string", "null"],
      "enum": ["HIGH", "MEDIUM", "LOW", "URGENT", null]
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "destination": {
      "type": ["string", "null"],
      "description": "Optional destination actor/object"
    },
    "end": {
      "type": "boolean"
    },
    "errors": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["code", "value"],
        "properties": {
          "code": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": ["version", "actions", "object", "end"],
  "additionalProperties": true
}
